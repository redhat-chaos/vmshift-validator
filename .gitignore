# Reports & generated output
reports/*
!reports/.gitkeep
scripts/generated/

# User config (generated from config.example.yaml via make init-config)
config.yaml
.config.mk

# Rendered kube-burner configs (generated from templates by make render-config)
kube-burner/.rendered-*.yml

# Generated mixed-workload config (created by make render-mixed-config)
kube-burner/vm-mixed.yml

# Logs
*.log

# SSH keys (users must generate their own)
keys/*
!keys/.gitkeep

# Cluster kubeconfigs
config/source-cluster/auth/kubeconfig
config/target-cluster/auth/kubeconfig

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env
.env.*
dist/
build/
*.egg-info/

# Testing
.coverage
htmlcov/
.pytest_cache/

# IDE
.vscode/
.idea/
.serena/

# OS files
.DS_Store
Thumbs.db

# Secrets & credentials
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials/

# Terraform
.terraform/
*.tfstate
*.tfstate.*

# Kubernetes
kubeconfig*
*.kubeconfig

# Environment profiles (contain bastion credentials)
profiles/*.env
!profiles/*.env.example

# Infrastructure docs (local copy from scale-lab, not committed)
infra/

# Misc
tmp/
temp/

# Claude AI context (contains local-only infrastructure references).
# Excludes contents (not the dirs themselves, via trailing /*) at each level so
# the cclm-test negations below can re-include specific files — a parent
# directory excluded outright (e.g. "dir/") can never be re-included by git.
.claude/*
!.claude/skills/

.claude/skills/*
!.claude/skills/cclm-test/

# ...except the cclm-test skill, which is shared — its real bastion config
# (env.yaml, generated from env.example.yaml) stays local and gitignored.
.claude/skills/cclm-test/*
!.claude/skills/cclm-test/skill.md
!.claude/skills/cclm-test/bug-guidelines.md
!.claude/skills/cclm-test/report-guidelines.md
!.claude/skills/cclm-test/env.example.yaml
!.claude/skills/cclm-test/chaos-injection-methods.md
!.claude/skills/cclm-test/sweep-execution.md
!.claude/skills/cclm-test/error-handling.md
!.claude/skills/cclm-test/result-analysis.md

# AI/IDE agent configs
.agents/
.cursor/
skills-lock.json

# Chaos test framework (contains bastion-specific paths)
cclm-chaos/

# Test specs (internal)
tests/

# Internal operational documentation (not for public repo)
CCLM-LIVE-MIGRATION.md

# Analysis and reference docs (local only)
docs/
